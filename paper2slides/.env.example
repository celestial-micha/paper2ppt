# Text LLM used for paper summarization, planning, and deck curation.
# DeepSeek is OpenAI-SDK compatible; keep your real API key only in paper2slides/.env.
RAG_LLM_API_KEY=your_api_key_here
RAG_LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
RAG_LLM_MAX_TOKENS=8192

# Fast RAG can include original paper images, but image payloads must use a vision-capable model.
RAG_FAST_INCLUDE_IMAGES=1
RAG_VISION_MODEL=gpt-5-mini
# Use a separate key/base URL for the vision model. Do not send image payloads to DeepSeek text models.
RAG_VISION_API_KEY=your_openai_or_vision_api_key_here
# RAG_VISION_BASE_URL=https://api.openai.com/v1
# RAG_VISION_BASE_URL=https://api.shunyu.tech/v1

# Optional override for the PPTX deck curator. If omitted, PPTX generation uses LLM_MODEL.
PPTX_LLM_MODEL=deepseek-v4-flash

# Optional: use a vision-capable model to understand extracted paper figures.
# auto analyzes only when captions look too weak for reliable slide curation.
PPTX_ENABLE_FIGURE_ANALYSIS=auto
PPTX_VISION_MODEL=gpt-5-mini
PPTX_VISION_API_KEY=your_openai_or_vision_api_key_here
# PPTX_VISION_BASE_URL=https://api.openai.com/v1
# PPTX_VISION_BASE_URL=https://api.shunyu.tech/v1
PPTX_MAX_FIGURE_ANALYSIS=5

# PPTX QA repair loop. Increase only if your decks are still too dense.
PPTX_QA_MAX_REPAIR_ATTEMPTS=2

